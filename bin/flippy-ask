#!/usr/bin/env python3
"""Ping the flippy daemon. Usage: flippy-ask [ask|draw|settings|setup|history|dismiss|reset|quit|ping]

Starts the daemon if it isn't running (so no autostart is needed).
"""
import os
import socket
import subprocess
import sys
import tempfile
import time

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, ROOT)
from flippy.profile import current

PROFILE = current()
SOCK = PROFILE.socket
DAEMON = os.path.join(os.path.dirname(os.path.realpath(__file__)), "flippy-daemon")
APPS = []
LOG = PROFILE.log
if sys.platform == "darwin":
    APPS = [os.environ.get("FLIPPY_APP") or PROFILE.app]
    if not PROFILE.demo:
        APPS.append("/Applications/Flippy.app")


def send(cmd):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(3)
        s.connect(SOCK)
        s.sendall((cmd + "\n").encode())
        return s.recv(4096).decode().strip()


def main():
    cmd = " ".join(sys.argv[1:]) or "ask"
    owned_stop = cmd == "stop-owned"
    if owned_stop:
        cmd = "quit-owned " + ROOT
    if cmd == "start":  # just make sure the daemon is running
        cmd = "ping"
        autostart = True
    else:
        autostart = not owned_stop and cmd not in ("quit", "dismiss", "ping", "doctor")
    try:
        result = send(cmd)
        if owned_stop and result != "ok":
            sys.exit(result)
        print(result)
        return
    except (FileNotFoundError, ConnectionRefusedError, ConnectionResetError):
        if not autostart:
            if owned_stop:
                return
            sys.exit("flippy daemon not running")
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    env = {k: v for k, v in os.environ.items() if k != "ANTHROPIC_API_KEY"}
    app = next((a for a in APPS if os.path.isdir(a)), None)
    if app:  # macOS: start through Flippy.app so the Screen Recording permission is Flippy's, not the terminal's
        subprocess.Popen(["open", "-g", app], env=env)
    else:
        with open(LOG, "ab") as log:
            subprocess.Popen([DAEMON], stdout=log, stderr=log, stdin=subprocess.DEVNULL,
                             start_new_session=True, env=env)
    for _ in range(100):
        time.sleep(0.1)
        try:
            print(send(cmd))
            return
        except (FileNotFoundError, ConnectionRefusedError, ConnectionResetError):
            pass
    sys.exit(f"flippy daemon didn't start; see {LOG}")


main()
